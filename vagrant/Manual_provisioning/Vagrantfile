        ngx01.vm.box = "eurolinux-vagrant/centos-stream-9"
        ngx01.vm.hostname = "ngx01"
        ngx01.vm.network "private_network", ip:"192.168.56.19"
        ngx01.vm.provider "virtualbox" do |vb|
            vb.memory = "600"
        end
